FROM node:24-bookworm

WORKDIR /app
ENV NODE_ENV=production
ENV COREPACK_HOME=/usr/local/share/corepack

RUN corepack enable

# Railway persistent volumes are mounted at container start and may arrive
# root-owned even when the image pre-creates the mountpoint for the node user.
# Keep a tiny privileged entrypoint solely to repair volume ownership, then
# drop back to the non-root node user before OpenClaw starts.
#
# The Railway image also runs NEO's native exec and Playwright tools.
# Debian 12 package names matter: libatspi2.0-0 (not libatspi0) is correct;
# libnssutil3.so and libsmime3.so are provided by the libnss3 package.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       ca-certificates \
       curl \
       fonts-liberation \
       gosu \
       libasound2 \
       libatk-bridge2.0-0 \
       libatk1.0-0 \
       libatspi2.0-0 \
       libcairo2 \
       libcups2 \
       libdbus-1-3 \
       libdrm2 \
       libfontconfig1 \
       libgbm1 \
       libglib2.0-0 \
       libgtk-3-0 \
       libnspr4 \
       libnss3 \
       libpango-1.0-0 \
       libpangocairo-1.0-0 \
       libx11-6 \
       libx11-xcb1 \
       libxcb1 \
       libxcomposite1 \
       libxdamage1 \
       libxext6 \
       libxfixes3 \
       libxkbcommon0 \
       libxrandr2 \
       libxshmfence1 \
       libxss1 \
       xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Fail the image build before deploying a runtime that cannot load Chromium.
# Browsers themselves live on the mounted OpenClaw volume and are probed there
# after deployment; this verifies the image's loader and shell prerequisites.
RUN /bin/bash -c 'set -euo pipefail; for so in \
    libnspr4.so libnss3.so libnssutil3.so libsmime3.so \
    libatk-1.0.so.0 libatk-bridge-2.0.so.0 libatspi.so.0 \
    libgbm.so.1 libasound.so.2; do \
    ldconfig -p | grep -Fq "$so" || { echo "missing Chromium library: $so" >&2; exit 1; }; \
    done'

COPY . .
# No paid inference or network: fail build if the signed-receipt Brain
# reference cannot be pinned to the exact canonical NEO factory doctrine.
RUN node --test scripts/neo-verified-brain-ref.test.mjs
# Verify NEO credential selection and terminal receipt truth on every production build.
RUN node --test test/neo-github-auth-preflight.test.mjs test/neo-agent-bus-receipt-status.test.mjs
RUN node --test scripts/neo-memory-boot-bound.test.mjs scripts/neo-google-free-qa.test.mjs
RUN corepack prepare "$(node -p "require('./package.json').packageManager")" --activate
RUN pnpm install --frozen-lockfile

RUN NODE_OPTIONS=--max-old-space-size=8192 pnpm build:docker
RUN pnpm exec vitest run src/agents/bootstrap-files-neo-brain.test.ts test/railway-neo-continuity.test.ts test/neo-agent-message-bus-auth.test.ts test/neo-agent-message-bus-execution.test.ts src/gateway/server/ws-connection/connect-policy.test.ts src/gateway/openai-http.neo-worker-receipt.test.ts src/agents/tools/image-generate-tool.test.ts
RUN cd ui && pnpm exec vitest run --config vitest.node.config.ts src/ui/founder-auto-launch.node.test.ts
RUN pnpm ui:build

RUN install -d -m 0700 -o node -g node /home/node/.openclaw /home/node/.openclaw/workspace

RUN ln -sf /app/openclaw.mjs /usr/local/bin/openclaw && chmod 755 /app/openclaw.mjs

RUN printf '%s\n' \
  '#!/bin/sh' \
  'set -eu' \
  'state_dir="${OPENCLAW_STATE_DIR:-/home/node/.openclaw}"' \
  'workspace_dir="${OPENCLAW_WORKSPACE_DIR:-$state_dir/workspace}"' \
  'if [ "$(id -u)" -eq 0 ]; then' \
  '  mkdir -p "$state_dir" "$workspace_dir"' \
  '  chown -R node:node "$state_dir"' \
  '  exec gosu node "$@"' \
  'fi' \
  'exec "$@"' \
  > /usr/local/bin/openclaw-railway-entrypoint \
  && chmod 0755 /usr/local/bin/openclaw-railway-entrypoint

ENTRYPOINT ["/usr/local/bin/openclaw-railway-entrypoint"]
EXPOSE 8080
CMD ["node","openclaw.mjs","gateway","--allow-unconfigured","--bind","lan","--port","8080"]
