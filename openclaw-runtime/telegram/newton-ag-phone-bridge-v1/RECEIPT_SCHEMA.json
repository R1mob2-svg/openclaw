{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AGExecutionReceiptSchema",
  "type": "object",
  "properties": {
    "receipt_id": { "type": "string" },
    "command_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED", "FAILED"] },
    "files_created": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_deleted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "secrets_printed": { "type": "boolean" },
    "live_systems_touched": { "type": "boolean" },
    "protected_surfaces_touched": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "next_safe_step": { "type": "string" }
  },
  "required": [
    "receipt_id",
    "command_id",
    "created_at",
    "status",
    "files_created",
    "files_modified",
    "files_deleted",
    "secrets_printed",
    "live_systems_touched",
    "protected_surfaces_touched",
    "summary",
    "next_safe_step"
  ]
}
